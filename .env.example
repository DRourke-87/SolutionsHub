# Copy to .env for local development. Never commit .env.
APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/solutionshub

# Sign-in
ALLOWED_EMAIL_DOMAINS=amentum.com,global.amentum.com,amentumcms.com
BOOTSTRAP_ADMIN_EMAIL=you@amentum.com

# Email: console (prints links to the log) or acs
EMAIL_BACKEND=console
ACS_ENDPOINT=
ACS_SENDER=DoNotReply@your-verified-domain.com
ACS_CONNECTION_STRING=

# Attachments: local (filesystem) or azure (Blob Storage, account connection string)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=attachments

SCHEDULER_ENABLED=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
